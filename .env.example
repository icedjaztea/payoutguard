# PayPal SANDBOX REST app (Developer Dashboard > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: comma-separated sandbox PERSONAL account emails to receive the test payouts
PAYOUT_TEST_RECIPIENTS=
# Webhook id from Developer Dashboard > your sandbox app > Features > Sandbox Webhooks.
# Without it, events cannot be verified and are refused unless you also set
# PAYPAL_ALLOW_UNVERIFIED_WEBHOOKS=1 (local testing only).
PAYPAL_WEBHOOK_ID=
#PAYPAL_ALLOW_UNVERIFIED_WEBHOOKS=1

# live = call the AI on a cache miss; cached = reuse out/cache only, never call the AI
AUDIT_MODE=cached

# AI provider: openai (default) or gemini (backup)
AI_PROVIDER=openai
OPENAI_API_KEY=
# Set to the newest OpenAI model on your account that accepts PDF + image input
OPENAI_MODEL=gpt-6.1-sol

# Optional backup — Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
