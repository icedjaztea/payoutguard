# PayPal SANDBOX REST app (Developer Dashboard > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: comma-separated sandbox PERSONAL account emails to receive the test payouts
PAYOUT_TEST_RECIPIENTS=

# AI provider: openai (default) or gemini (backup)
AI_PROVIDER=openai
OPENAI_API_KEY=
# Set to the newest OpenAI model on your account that accepts PDF + image input
OPENAI_MODEL=gpt-6.1-sol

# Optional backup — Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
